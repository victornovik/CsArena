# Top-most EditorConfig file for the whole repository.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

# Keep each file's existing BOM: most C# sources and project files carry one, so don't pin a charset here.
[*.{cs,csproj,props,targets}]
charset = unset

[*.{csproj,props,targets,slnx,json,yml,yaml}]
indent_size = 2

[*.md]
# Two trailing spaces are a Markdown line break.
trim_trailing_whitespace = false

[*.cs]
# Suggestions only: the build uses EnforceCodeStyleInBuild together with TreatWarningsAsErrors.
dotnet_sort_system_directives_first = true
csharp_style_prefer_collection_expression = true:suggestion
dotnet_style_collection_initializer = true:suggestion
dotnet_diagnostic.IDE0028.severity = suggestion
dotnet_diagnostic.IDE0300.severity = suggestion
dotnet_diagnostic.IDE0301.severity = suggestion
dotnet_diagnostic.IDE0305.severity = suggestion

[*.csv]
end_of_line = unset
trim_trailing_whitespace = false
