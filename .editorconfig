# Top-most EditorConfig file for the whole repository.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

# UTF-8 with BOM for C# sources, MSBuild files, the solution file and Markdown.
# Not applied to .json, .gitignore, .gitattributes or this file: a BOM can break their parsers.
[*.{cs,csproj,props,targets,slnx,md}]
charset = utf-8-bom

[*.{csproj,props,targets,slnx,json,yml,yaml}]
indent_size = 2

[*.md]
# Two trailing spaces are a Markdown line break.
trim_trailing_whitespace = false

[*.cs]
# Suggestions only: the build uses EnforceCodeStyleInBuild together with TreatWarningsAsErrors.
dotnet_sort_system_directives_first = true
csharp_style_prefer_collection_expression = true:suggestion
dotnet_style_collection_initializer = true:suggestion
dotnet_diagnostic.IDE0028.severity = suggestion
dotnet_diagnostic.IDE0300.severity = suggestion
dotnet_diagnostic.IDE0301.severity = suggestion
dotnet_diagnostic.IDE0305.severity = suggestion

[*.csv]
end_of_line = unset
trim_trailing_whitespace = false

# AsyncTests exercises threads, locks and OS primitives whose blocking calls cannot observe a CancellationToken.
# Every test there has a Timeout (TestTimeouts.Default) as the safety net, so the "reference the test token"
# hint (xUnit1069) is only a suggestion for this file.
[CsArena/test/CsArena.Tests/AsyncTests.cs]
dotnet_diagnostic.xUnit1069.severity = suggestion
